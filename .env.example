# Copy thành .env và điền giá trị thật. KHÔNG commit file .env.

# --- PostgreSQL + TimescaleDB ---
POSTGRES_USER=eth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eth_market
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://eth:change-me@localhost:5432/eth_market

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Data providers (để trống nếu chưa dùng) ---
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
DNSE_USERNAME=
DNSE_PASSWORD=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

