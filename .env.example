# Copy thành .env và điền giá trị thật. KHÔNG commit file .env.

# --- Database (PostgreSQL / Supabase / TimescaleDB) ---
# Chọn 1 trong 2 cách:
# Cách 1 - Dùng Supabase (Khuyên dùng khi không có Docker):
#   Lấy Connection string URI (Transaction pooler port 6543 hoặc Session port 5432) trong Supabase Dashboard -> Settings -> Database:
#   postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Cách 2 - Dùng Docker local:
#   postgresql+psycopg://eth:change-me@localhost:5432/eth_market
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Cấu hình Docker local (nếu dùng Docker Compose sau này)
POSTGRES_USER=eth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eth_market
POSTGRES_PORT=5432

# --- Redis (Tùy chọn: Upstash Cloud hoặc Docker local) ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Data providers (để trống nếu chưa dùng) ---
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
DNSE_USERNAME=
DNSE_PASSWORD=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
