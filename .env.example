# Copy thành .env và điền giá trị thật. KHÔNG commit file .env.

# --- Database (PostgreSQL / Supabase / TimescaleDB) ---
# Chọn 1 trong 2 cách:
# Cách 1 - Dùng Supabase (Khuyên dùng khi không có Docker):
#   Supabase Dashboard -> nút "Connect" -> chọn "Session pooler" -> copy URI, rồi đổi
#   tiền tố "postgresql://" thành "postgresql+psycopg://" và thêm "?sslmode=require".
#   postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-[N]-[region].pooler.supabase.com:5432/postgres?sslmode=require
#   Lưu ý:
#   - KHÔNG dùng "Direct connection" (db.[project-ref].supabase.co): host này chỉ có IPv6,
#     mạng không có IPv6 sẽ báo lỗi "failed to resolve host".
#   - Username phải có dạng "postgres.[project-ref]" (có phần project-ref).
#   - Tiền tố host (aws-0 / aws-1) và region phải copy đúng từ Dashboard, sai sẽ báo
#     "tenant/user ... not found".
#   - Dùng Session pooler (port 5432) cho app/Alembic. Transaction pooler (port 6543)
#     không hỗ trợ prepared statements, dễ lỗi với SQLAlchemy/psycopg.
# Cách 2 - Dùng Docker local:
#   postgresql+psycopg://eth:change-me@localhost:5432/eth_market
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-[N]-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Cấu hình Docker local (nếu dùng Docker Compose sau này)
POSTGRES_USER=eth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eth_market
POSTGRES_PORT=5432

# --- Redis (Tùy chọn: Upstash Cloud hoặc Docker local) ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Data providers (để trống nếu chưa dùng) ---
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
DNSE_USERNAME=
DNSE_PASSWORD=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Origin của web app được phép gọi API từ trình duyệt (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
