# Copy thành .env.local nếu cần đổi. KHÔNG commit .env.local.

# Địa chỉ FastAPI backend (services/api). Mặc định: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Đăng nhập (Supabase Auth). Bỏ trống thì nút Đăng nhập báo "chưa cấu hình".
# Supabase -> Project Settings -> API Keys. Đây là khóa công khai; KHÔNG dùng secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
